generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY_FOR_COLLECTION
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum FulfilmentMethod {
  COLLECTION
  DELIVERY
}

enum PaymentStatus {
  UNPAID
  PAID_CASH
  PAID_EFT
  PAID_OTHER
}

enum EnquiryStatus {
  NEW
  READ
  CLOSED
}

enum InventoryMovementType {
  RESERVE
  RELEASE
  DEDUCT_COMPLETE
  MANUAL_ADJUSTMENT
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(STAFF)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@index([email])
  @@index([role, active])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([active, sortOrder])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([active, name])
}

model Product {
  id                  String           @id @default(cuid())
  name                String
  slug                String           @unique
  brandId             String?
  categoryId          String
  shortDescription    String
  descriptionMarkdown String
  status              ProductStatus    @default(DRAFT)
  featured            Boolean          @default(false)
  productTypeLabel    String?
  thcContent          String?
  cbdContent          String?
  weightLabel         String?
  terpenes            String?
  flavourNotes        String?
  labTestUrl          String?
  batchNumber         String?
  storageNotes        String?
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  brand      Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([status, featured])
  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id                  String   @id @default(cuid())
  productId           String
  name                String
  sku                 String   @unique
  priceCents          Int
  compareAtPriceCents Int?
  stockQuantity       Int      @default(0)
  reservedQuantity    Int      @default(0)
  lowStockThreshold   Int      @default(3)
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@index([productId, active, sortOrder])
  @@index([priceCents])
}

model Order {
  id                String           @id @default(cuid())
  publicId          String           @unique
  status            OrderStatus      @default(PENDING)
  customerFirstName String
  customerLastName  String
  email             String
  phone             String
  fulfilmentMethod  FulfilmentMethod @default(COLLECTION)
  addressLine1      String?
  addressLine2      String?
  suburb            String?
  city              String?
  province          String?
  postalCode        String?
  preferredDateTime String?
  notes             String?
  adminNotes        String?
  subtotalCents     Int
  deliveryFeeCents  Int              @default(0)
  totalCents        Int
  paymentMethod     String?
  paymentStatus     PaymentStatus    @default(UNPAID)
  ageConfirmedAt    DateTime
  termsAcceptedAt   DateTime
  privacyAcceptedAt DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  items     OrderItem[]
  movements InventoryMovement[]

  @@index([status, createdAt])
  @@index([email])
  @@index([publicId])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  productId           String?
  variantId           String?
  productNameSnapshot String
  variantNameSnapshot String
  skuSnapshot         String
  unitPriceCents      Int
  quantity            Int
  lineTotalCents      Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  variantId     String
  orderId       String?
  type          InventoryMovementType
  quantityDelta Int
  note          String?
  createdAt     DateTime              @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
}

model Enquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String?
  productSlug String?
  message     String
  type        String        @default("GENERAL")
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

model ContentPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  bodyMarkdown   String
  published      Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug, published])
}

model SiteSetting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  userEmail    String?
  action       String
  entityType   String
  entityId     String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model FaqItem {
  id             String   @id @default(cuid())
  question       String
  answerMarkdown String
  category       String?
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@index([active, sortOrder])
}
