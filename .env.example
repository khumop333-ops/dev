# ==============================================================================
# Highveld Herbal Co. — White-Label Dispensary Template (.env.example)
# Copy this file to `.env` for local development.
# Do NOT commit `.env` with real production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Connection
# Matches the included `docker-compose.yml` or local Postgres instance.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/highveld_herbal?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication (NextAuth / Auth.js)
# Generate a strong secret in production: `openssl rand -base64 32`
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET="replace-with-a-secure-random-32-byte-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Public Site Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_WHATSAPP_NUMBER="27820000000"

# ------------------------------------------------------------------------------
# 4. Initial Seed Admin Credentials
# Used ONLY by `npm run db:seed`. Change immediately after first production login.
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@highveldherbal.co.za"
ADMIN_PASSWORD="ChangeMePretoria2026!"
STAFF_EMAIL="staff@highveldherbal.co.za"
STAFF_PASSWORD="StaffPretoria2026!"

# ------------------------------------------------------------------------------
# 5. Optional Transactional Email (Resend / SMTP)
# Leave blank in local development to log emails cleanly to stdout.
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Highveld Herbal Co. <orders@example.co.za>"
ADMIN_NOTIFICATION_EMAIL="hello@example.co.za"

# ------------------------------------------------------------------------------
# 6. Optional Cloud Storage Placeholders (Future Production Uploads)
# By default, admin accepts image URLs or writes to `public/uploads` in local dev.
# ------------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=""
# S3_BUCKET=""
# S3_REGION="af-south-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# 7. Optional Future South African Payment Provider Placeholders
# Default store mode is `reservation` (no online card payment taken in V1).
# ------------------------------------------------------------------------------
# PAYMENT_PROVIDER="manual" # manual | yoco | paystack | ozow | peach | payfast
# YOCO_SECRET_KEY=""
# PAYSTACK_SECRET_KEY=""
# OZOW_SITE_CODE=""
# PAYFAST_MERCHANT_ID=""
