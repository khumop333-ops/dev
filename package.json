{
  "name": "highveld-herbal-dispensary-template",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready white-label South African herbal & botanical dispensary template (Pretoria, Gauteng default).",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "npm run db:generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/generate-prisma.mjs",
    "db:push": "tsx scripts/migrate.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:dev": "tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:local-server": "tsx scripts/local-postgres.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/newsreader": "^5.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.454.0",
    "nanoid": "^5.0.8",
    "next": "14.2.18",
    "next-auth": "^4.24.10",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-markdown": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
